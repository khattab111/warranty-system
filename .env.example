APP_NAME="Warranty System"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_FAKER_LOCALE=ar_SA
APP_FALLBACK_LOCALE=en
APP_LOCALE=ar
APP_TIMEZONE=Asia/Damascus
APP_URL=http://localhost
APP_VERSION=1
ASSET_URL=${APP_URL}

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=warranty_system
DB_USERNAME=warranty_system
DB_PASSWORD=warranty_system

CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
FILESYSTEM_DISK=public
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=warranty@example.com
MAIL_FROM_NAME="${APP_NAME}"

THREELWAN_API_TOKEN=
THREELWAN_BASE_URL=https://3lwan-store.com

VITE_APP_NAME=${APP_NAME}

